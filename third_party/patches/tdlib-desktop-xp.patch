+
+static int inet_pton_compat(int family, const char *source, void *destination) {
+#if TD_WINDOWS && (!defined(_WIN32_WINNT) || _WIN32_WINNT < 0x0600)
+  string with_port;
+  if (family == AF_INET6) {
+    with_port = "[";
+    with_port += source;
+    with_port += "]:0";
+  } else if (family == AF_INET) {
+    with_port = source;
+    with_port += ":0";
+  } else {
+    return -1;
+  }
+  SOCKADDR_STORAGE address;
+  int address_length = sizeof(address);
+  std::memset(&address, 0, sizeof(address));
+  if (WSAStringToAddressA(with_port.data(), family, nullptr, reinterpret_cast<SOCKADDR *>(&address), &address_length) != 0) {
+    return 0;
+  }
+  if (family == AF_INET) {
+    std::memcpy(destination, &reinterpret_cast<SOCKADDR_IN *>(&address)->sin_addr, sizeof(in_addr));
+  } else {
+    std::memcpy(destination, &reinterpret_cast<SOCKADDR_IN6 *>(&address)->sin6_addr, sizeof(in6_addr));
+  }
+  return 1;
+#else
+  return inet_pton(family, source, destination);
+#endif
 }
 
