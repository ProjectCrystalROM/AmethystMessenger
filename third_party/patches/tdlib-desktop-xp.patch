+#else
+  stat.total_ticks_ = get_tick_count_64_compat() * 10000;
+#endif
   auto hardware_concurrency = thread::hardware_concurrency();
   if (hardware_concurrency != 0) {
     stat.total_ticks_ *= hardware_concurrency;
