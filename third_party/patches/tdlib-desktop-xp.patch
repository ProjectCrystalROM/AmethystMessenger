+#if TD_PORT_WINDOWS && (!defined(_WIN32_WINNT) || _WIN32_WINNT < 0x0600)
+namespace {
+uint64 get_tick_count_64_compat() {
+  static volatile LONG last_tick = 0;
+  static volatile LONG tick_high = 0;
+  const DWORD now = GetTickCount();
+  const DWORD previous = static_cast<DWORD>(InterlockedExchange(&last_tick, static_cast<LONG>(now)));
+  if (now < previous) {
+    InterlockedIncrement(&tick_high);
+  }
+  const DWORD high = static_cast<DWORD>(InterlockedCompareExchange(&tick_high, 0, 0));
+  return (static_cast<uint64>(high) << 32) | now;
+}
+}  // namespace
+#endif
+
