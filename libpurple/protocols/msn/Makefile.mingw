PIDGIN_TREE_TOP := ../../..
include $(PIDGIN_TREE_TOP)/libpurple/win32/global.mak
include pecan-build.mk

GLIB_TOP ?= $(WIN32_DEV_TOP)/glib-2.28.8
TARGET = libmsn.dll
OBJECTS = $(PECAN_SOURCES:.c=.o) win32/resource.res
DLL_INSTALL_DIR = $(PURPLE_INSTALL_PLUGINS_DIR)

DEFINES := $(filter-out -DHAVE_CONFIG_H,$(DEFINES)) $(PECAN_DEFINES)
INCLUDE_PATHS += -I. \
	-I$(GLIB_TOP)/include/glib-2.0 -I$(GLIB_TOP)/lib/glib-2.0/include \
	-I$(GTK_TOP)/include -I$(LIBXML2_TOP)/include/libxml2 \
	-I$(PURPLE_TOP) -I$(PURPLE_TOP)/win32 -I$(PIDGIN_TREE_TOP)
LIB_PATHS += -L$(GLIB_TOP)/lib -L$(GTK_TOP)/lib -L$(PURPLE_TOP)
LIBS = -lpurple -lgio-2.0 -lgobject-2.0 -lglib-2.0 -lintl -lws2_32

include $(PIDGIN_COMMON_RULES)

.PHONY: all install clean
all: $(TARGET)

install: all $(DLL_INSTALL_DIR)
	cp $(TARGET) $(DLL_INSTALL_DIR)

$(filter %.o,$(OBJECTS)): $(PURPLE_VERSION_H)

win32/resource.res: win32/resource.rc
	$(WINDRES) $< -O coff -o $@

$(TARGET): $(OBJECTS) $(PURPLE_DLL).a
	$(CC) -shared $(OBJECTS) $(LIB_PATHS) $(LIBS) $(DLL_LD_FLAGS) \
		-static-libgcc -Wl,--major-subsystem-version,5,--minor-subsystem-version,1 -o $@

clean:
	rm -f $(OBJECTS) $(TARGET)

include $(PIDGIN_COMMON_TARGETS)
